<#import "layout.ftlh" as layout>

<@layout.page title="About">

    <section class="about-section">

        <h2>Welcome to the Marvel Character Gallery</h2>

        <img
            src="/images/Marvel.jpg"
            alt="Marvel Characters"
            class="about-image"
        >

        <p>
            The Marvel Character Gallery showcases iconic characters
            from the Marvel universe, including Spider-Man, Iron Man,
            Captain America, Black Panther, and Thor.
        </p>

        <h2>Data &amp; Attribution</h2>

        <p>
            The characters featured in this gallery are from the Marvel
            universe. All character descriptions, roles, abilities, and
            background information are based on their appearances in
            Marvel stories and productions.
        </p>

        <p>
            Images used in this gallery are included for demonstration
            and educational purposes as part of this Spring Boot
            web application project.
        </p>

    </section>

</@layout.page>